# Application Environment Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Security & Authentication
# Generate a strong random 64-character hex string for production
JWT_SECRET="replace_with_a_strong_random_secret_before_production"
JWT_EXPIRES_IN="8h"

# Database Configuration
# Default uses SQLite (zero-config local/development database)
DB_CLIENT="sqlite"
SQLITE_DB_PATH="./database/casid_pharma.db"

# Optional PostgreSQL Connection (for external RDBMS production deployment)
# DB_CLIENT="postgres"
# DATABASE_URL="postgresql://username:password@localhost:5432/casid_pharma"

# Initial Super Admin Setup
# Password is NEVER hardcoded in source code. Set via /admin/setup UI or CLI setup script.
INITIAL_ADMIN_EMAIL="shaheed@gmail.com"
# INITIAL_ADMIN_PASSWORD=""

# File Uploads
UPLOAD_MAX_SIZE_MB=5
